# Session odysseus ouverte au démarrage sur un terminal (instance : tty1),
# verrouillée : l'écran de verrouillage d'odysseus sert d'écran de connexion
# (mot de passe vérifié par PAM), puis le bureau apparaît en fondu.
# Aucun shell interactif : si la session s'arrête, le service la rouvre,
# verrouillée. L'utilisateur est donné par un fichier à côté
# (odysseus-session@.service.d/utilisateur.conf : [Service] User=…).
# @SESSION@ : chemin d'odysseus-session.sh (remplacé à l'installation).
[Unit]
Description=Session odysseus sur %I, ouverte verrouillée
Documentation=https://github.com/dcourtin/odysseus-desktop
After=systemd-user-sessions.service plymouth-quit-wait.service getty@%i.service
Conflicts=getty@%i.service
# Une session qui ne démarre pas ne tourne pas en boucle : les autres tty restent là
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
PAMName=login
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=%I
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland ODYSSEUS_VERROU=1
WorkingDirectory=~
# Shell de login non interactif : l'environnement de l'utilisateur (PATH…), sans invite
ExecStart=/bin/bash -l -c 'exec @SESSION@'
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
